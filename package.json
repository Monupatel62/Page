{
  "name": "page",
  "version": "1.0.0",
  "private": true,
  "description": "A developer-managed, MDX-powered publishing platform.",
  "engines": {
    "node": "22.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run content:check && next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "content:check": "tsx scripts/check-content.ts",
    "validate": "npm run content:check && npm run type-check && npm run lint",
    "ci": "npm run validate && npm run build"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "katex": "^0.18.2",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "next-mdx-remote": "6.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.1.12",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/mdx": "^2.0.13"
  },
  "overrides": {
    "katex": "^0.18.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
